# Provider selection. auto (default): typesafe if TYPESAFE_API_KEY is set, else jev if
# AI_GATEWAY_API_KEY is set, else mock. Force with typesafe, jev or mock.
# TRIAGE_PROVIDER=auto

# TypeSafe AI account key. Calls Jev directly at https://api.typesafe.ai/v1/systemone
# TYPESAFE_API_KEY=your_key_here
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_MODEL_ID=jev-latest

# Vercel AI Gateway key. Calls Jev through the gateway instead.
# AI_GATEWAY_API_KEY=your_key_here
# JEV_MODEL_ID=typesafe-ai/jev

# SQLite file. Created on first start and seeded with sample tickets.
# DATABASE_URL=sqlite:///./jev.db

# Provider call budget. Transient failures (timeouts, 429, 5xx) are retried with backoff
# until the attempts or the total deadline run out.
# TRIAGE_MAX_ATTEMPTS=3
# TRIAGE_DEADLINE_SECONDS=10
# TRIAGE_CONNECT_TIMEOUT_SECONDS=3
# TRIAGE_READ_TIMEOUT_SECONDS=8

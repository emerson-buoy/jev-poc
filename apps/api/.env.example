# Vercel AI Gateway key. Optional: without it the API runs in mock triage mode.
# AI_GATEWAY_API_KEY=your_key_here

# auto (default): jev when a key is set, mock otherwise. Force with jev or mock.
# TRIAGE_PROVIDER=auto

# Evaluation model id resolved through the gateway.
# JEV_MODEL_ID=typesafe-ai/jev

# SQLite file. Created on first start and seeded with sample tickets.
# DATABASE_URL=sqlite:///./jev.db
